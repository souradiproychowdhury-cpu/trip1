# AI Providers — configure at least one (Gemini recommended)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_PROVIDER_PRIORITY=gemini,openai,anthropic

# Fast strong model defaults
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Auth & Security
JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google Maps (Enable Maps JavaScript API, Places API, Directions API in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Transit Timing APIs (Flights & Trains)
FLIGHT_TIMING_API_KEY=your_flight_api_key_here
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
TRAIN_TIMING_API_KEY=your_train_api_key_here
RAIL_API_KEY=your_train_api_key_here

# Travel Partner & Hotel Suggestions API
TRAVEL_PARTNER_API_KEY=your_travel_partner_hotel_api_key_here
HOTEL_API_KEY=your_travel_partner_hotel_api_key_here
GOOGLE_HOTEL_API_KEY=your_travel_partner_hotel_api_key_here
